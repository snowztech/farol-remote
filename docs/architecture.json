  "cards": [
    { "dot": "cyan", "title": "Swift package, both apps", "items": ["RemoteMessages: RemoteCommand from the phone, RemoteEvent from the Mac", "Pairing: one HPKE message proving the phone's key and the QR secret", "SecureChannel: an HPKE stream each way, tied to both nonces", "MacLink and PhoneLink: no sockets, frames in and what to do out"] },
    { "dot": "emerald", "title": "Relay", "items": ["Room name is the SHA-256 of the Mac's public key", "One byte says what a frame is: data, joined, left, online, offline, push", "Mac frames carry a phone number, so the relay knows where they go", "Stores nothing and logs counts only"] },
    { "dot": "violet", "title": "Bridge", "items": ["Lives in the farol app, in RemoteBridge.swift", "Sends the session list and the open screen, in full, when they change", "Types a command once, even if it arrives twice", "Asks for a notification when an agent waits or finishes"] },
    { "dot": "amber", "title": "CLI on a server", "items": ["Takes the Mac's place: same room, same frames, the phone cannot tell", "Every tmux session is one the phone can open", "Pairing and the channel are written again in Go, and tested against what the Swift package seals", "Shows the QR code in the terminal"] }
  ]
