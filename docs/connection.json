  "cards": [
    { "dot": "rose", "title": "Pair, once", "items": ["Only the QR arrow skips the relay", "The secret in the code is what lets a phone pair", "The Mac remembers the phone's public key"] },
    { "dot": "cyan", "title": "Handshake, every connection", "items": ["Hellos are in the clear: a key and a fresh nonce", "Each side sends an HPKE key the other opens", "Both streams are tied to both nonces, so a replay fails"] },
    { "dot": "emerald", "title": "Session and notify", "items": ["Every Mac to phone arrow passes through the relay as bytes it cannot open", "Commands carry an id, so one sent twice is typed once", "The Mac picks waiting or done, the relay writes the words"] }
  ]
